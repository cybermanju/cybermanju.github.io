# Slow drift that continues the DOM loader's zoom after the overlay fades. No
# alpha: a screen re-render (any hover) would restart the animation and flash the
# title back in, so the reveal is owned by the overlay's own fade.
transform stem_title_drift:
    subpixel True
    zoom 1.02
    linear 42.0 zoom 1.075
    linear 42.0 zoom 1.02
    repeat


################################################################################
## Dialogue box
################################################################################

# Standing cast stage. Each slot is one left-side column along the dialogue box:
# slot 1 is the chapter's master, later slots join as speaking masters appear.
# A `show` with a new image tag is additive, so the previous portrait is never
# replaced; the 600x800 renders stand at full height and the box covers their
# feet like a conventional VN. Nothing here is animated or lip-synced.
transform stem_stage_slot_1:
    subpixel True
    xalign 0.02
    yalign 1.0
    yoffset 6
    zoom 0.78

transform stem_stage_slot_2:
    subpixel True
    xalign 0.17
    yalign 1.0
    yoffset 6
    zoom 0.78

transform stem_stage_slot_3:
    subpixel True
    xalign 0.32
    yalign 1.0
    yoffset 6
    zoom 0.78

transform stem_stage_slot_4:
    subpixel True
    xalign 0.47
    yalign 1.0
    yoffset 6
    zoom 0.78


screen say(who, what):
    $ store.stem_last_dialogue_text = str(what)
    $ _stem_small = stem_compact_layout()
    $ _stem_narrator = who is None or who == "ORBE // NARRADOR"
    $ _stem_speaker = None if _stem_narrator else who
    # A portrait appears only when one is explicitly mapped. Repeating the same
    # generic silhouette beside 94 different names implies an identity the art
    # does not have; unmapped speakers get their full width back for text.
    $ _stem_portrait = stem_speaker_portraits.get(str(_stem_speaker)) if _stem_speaker else None
    $ _stem_avatar = 104 if _stem_small else 128
    $ _stem_body = stem_body_size(_stem_small)

    window:
        id "window"
        xalign 0.5
        yalign 1.0
        xfill True
        xmaximum (config.screen_width - 48 if _stem_small else 1720)
        # Size to the text instead of a fixed panel height: a fixed height plus a
        # ymaximum on the text silently clips long narration pages.
        ymaximum (config.screen_height - 140)
        padding (24 if _stem_small else 34, 20 if _stem_small else 26)
        background "stem_ui_dialogue"

        vbox:
            xfill True
            spacing (10 if _stem_small else 14)

            hbox:
                xfill True
                spacing 12
                frame:
                    padding (16, 9)
                    background "stem_ui_nameplate"
                    xmaximum (config.screen_width - 160 if _stem_small else 1180)
                    text (who if who else "NARRADOR") id "who" style "say_label" size (24 if _stem_small else 28)
                null width 1 xfill True
                text ("TOQUE · AVANÇAR" if _stem_small else "CLIQUE / ENTER · AVANÇAR") size (16 if _stem_small else 16) color "#a9b9c4" yalign 0.5

            hbox:
                xfill True
                spacing (20 if _stem_small else 26)
                if _stem_narrator:
                    frame:
                        xsize _stem_avatar
                        ysize _stem_avatar
                        padding (10, 10)
                        background "stem_ui_panel"
                        add "narrator_orb":
                            xsize _stem_avatar - 22
                            ysize _stem_avatar - 22
                            xalign 0.5
                            yalign 0.5
                elif _stem_portrait:
                    frame:
                        xsize _stem_avatar
                        ysize _stem_avatar
                        padding (8, 8)
                        background "stem_ui_interstitial"
                        add _stem_portrait:
                            xsize _stem_avatar - 18
                            ysize _stem_avatar - 18
                            xalign 0.5
                            yalign 0.5
                text what id "what" style "say_dialogue" size _stem_body xfill True text_align 0.0 yalign 0.0


################################################################################
## Story choices and quizzes
################################################################################

screen stem_choice_rows(items, small):
    style_prefix "choice"

    vbox:
        xfill True
        spacing (16 if small else 18)
        for index, item in enumerate(items, 1):
            textbutton stem_option_label(index, item.caption) action item.action:
                xfill True
                yminimum (100 if small else 90)


screen choice(items):
    style_prefix "choice"
    zorder 80
    modal True

    add Solid("#05070fe0")
    $ _stem_small = stem_compact_layout()
    $ _stem_many = len(items) > 6
    $ _stem_yalign = 0.34 if _stem_many else 0.42
    $ _stem_card_max = (config.screen_height - 160) if _stem_small else (config.screen_height - 240)
    $ _stem_question = "?" in stem_last_dialogue_text or "？" in stem_last_dialogue_text

    # Number keys pick the matching numbered option. Bounded to nine so the
    # binding never runs past the end of a long chapter list.
    for _stem_index, _stem_item in enumerate(items[:9], 1):
        key str(_stem_index) action _stem_item.action

    frame:
        xalign 0.5
        yalign _stem_yalign
        xfill True
        xmaximum (config.screen_width - 64 if _stem_small else 1260)
        ymaximum _stem_card_max
        style "stem_pixel_vine_choice"

        vbox:
            xfill True
            spacing (14 if _stem_small else 18)

            hbox:
                xfill True
                add "stem_ui_vine_divider" xalign 0.5
                text ("PERGUNTA" if _stem_question else "ESCOLHA") size (22 if _stem_small else 20) color stem_theme_accent bold True yalign 0.5
                null width 1 xfill True
                text (("%d opções · teclas 1–%d" % (len(items), len(items))) if len(items) <= 9 else ("%d opções" % len(items))) size (20 if _stem_small else 18) color "#a9b9c4" yalign 0.5
                add "stem_ui_vine_divider" xalign 0.5

            frame:
                xfill True
                padding (20 if _stem_small else 26, 14 if _stem_small else 20)
                background "stem_ui_choice"
                text stem_last_dialogue_text size (30 if _stem_small else 28) color "#f6efe9" xfill True text_align 0.0 yalign 0.0

            if _stem_many:
                viewport:
                    xfill True
                    ymaximum _stem_card_max - 230
                    mousewheel True
                    draggable True
                    pagekeys True
                    scrollbars "vertical"
                    use stem_choice_rows(items, _stem_small)
            else:
                use stem_choice_rows(items, _stem_small)


