{
  "name": "cybermanju-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icon-set.mjs",
    "predev": "npm run icons",
    "dev": "vite",
    "prebuild": "npm run icons",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "pretypecheck": "npm run icons",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:watch": "vue-tsc --noEmit --watch",
    "lint": "vue-tsc --noEmit",
    "rust:check": "cargo check --workspace --all-targets",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:fmt:fix": "cargo fmt --all",
    "rust:test": "cargo test --workspace --no-fail-fast",
    "check:all": "npm run typecheck && npm run rust:check && npm run rust:clippy",
    "clean": "rm -rf dist target src-tauri/target cybermanju.db tantivy_index",
    "db:reset": "rm -f cybermanju.db tantivy_index",
    "prebuild:wasm:frontend": "npm run icons",
    "build:wasm": "npm run build:wasm:pkg && vite build --mode production --config vite.config.wasm.ts --outDir dist-wasm",
    "build:wasm:pkg": "wasm-pack build crates/os-wasm --target web --out-dir pkg",
    "build:wasm:frontend": "vite build --mode production --config vite.config.wasm.ts --outDir dist-wasm",
    "test": "vitest run"
  },
  "dependencies": {
    "@dweb-browser/zstd-wasm": "^1.2.1",
    "@iconify/vue": "^5.0.3",
    "@supabase/supabase-js": "^2.109.0",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-deep-link": "~2.4.10",
    "@tauri-apps/plugin-dialog": "^2.2.1",
    "@tauri-apps/plugin-fs": "^2.2.1",
    "@tauri-apps/plugin-notification": "^2.2.1",
    "@tauri-apps/plugin-os": "^2.2.1",
    "@tauri-apps/plugin-process": "^2.2.1",
    "@tauri-apps/plugin-shell": "^2.2.1",
    "@tauri-apps/plugin-store": "^2.2.1",
    "@vueuse/core": "^14.4.0",
    "maplibre-gl": "^6.12.0",
    "pinia": "^3.0.2",
    "tauri-plugin-scoped-storage-api": "1.5.1",
    "vue": "^3.5.43"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "source-map-js": "^1.2.2",
    "nanoid": "^3.3.20"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.13",
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.8"
  }
}
